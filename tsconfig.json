{
  "include": ["next-env.d.ts", "src/**/*", "client/src/**/*", "shared/**/*", "server/**/*", "script/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", ".open-next", "**/*.test.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@assets/*": ["./attached_assets/*"]
    }
  }
}
