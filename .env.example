# Required settings (NoA Production: `noa env set` / `noa env import`; local: .env.local).
# The API refuses requests when any of these is missing.

# Vibe Base rw connection (postgresql://<rw user>:<password>@<pgbouncer host>:5432/<vb_db_...>)
DATABASE_URL=postgresql://user:password@host:5432/database

# Admin mode password
ADMIN_PASSWORD=your-admin-password-here

# Signs admin login tokens (long random string)
JWT_SECRET=your-random-secret-here
